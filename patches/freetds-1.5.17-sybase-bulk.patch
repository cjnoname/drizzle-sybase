 /**
+ * Detect if table we're writing to uses 'datarows' lockmode.
+ * \tds
+ * \param bcpinfo BCP information already prepared
+ * \return TDS_SUCCESS or TDS_FAIL.
+ */
+static TDSRET
+probe_sap_locking(TDSSOCKET *tds, TDSBCPINFO *bcpinfo)
+{
+	TDSRET rc;
+	unsigned int value;
+	bool value_found;
+	TDS_INT resulttype;
+	int done_flags;
+	bool failed;
+	const char *full_tablename, *dot;
+
+	/* Only needed for inward data */
+	if (bcpinfo->direction != TDS_BCP_IN)
+		return TDS_SUCCESS;
+
+	/* Only needed for SAP ASE versions which support datarows-locking. */
+	if (!TDS_IS_SYBASE(tds) || !tds_capability_has_req(tds->conn, TDS_REQ_DOL_BULK))
+		return TDS_SUCCESS;
+
+	/* The lock scheme of exactly the target object -- 1 for allpages, 2 for
+	 * data-only locking (datapages or datarows), 0 if unknown: looked up by its full name (owner included), in its own
+	 * database -- the named one for db.owner.table / db..table, the session's
+	 * temporary database for a #temp table (on a server with several, not always
+	 * tempdb), else the current one. A lookup by bare name in sysobjects could
+	 * match another owner's table of the same name. */
+	full_tablename = tds_dstr_cstr(&bcpinfo->tablename);
+	dot = strchr(full_tablename, '.');
+	if (full_tablename[0] == '#') {
+		rc = tds_submit_queryf(tds, "select case lockscheme(object_id('%s'), @@tempdbid) "
+				       "when 'allpages' then 1 when 'datarows' then 2 when 'datapages' then 2 else 0 end",
+				       full_tablename);
+	} else if (dot != NULL && strchr(dot + 1, '.') != NULL) {
+		rc = tds_submit_queryf(tds, "select case lockscheme(object_id('%s'), db_id('%.*s')) "
+				       "when 'allpages' then 1 when 'datarows' then 2 when 'datapages' then 2 else 0 end",
+				       full_tablename, (int) (dot - full_tablename), full_tablename);
+	} else {
+		rc = tds_submit_queryf(tds, "select case lockscheme(object_id('%s')) "
+				       "when 'allpages' then 1 when 'datarows' then 2 when 'datapages' then 2 else 0 end",
+				       full_tablename);
+	}
+	TDS_PROPAGATE(rc);
+
+	value = 0;
+	value_found = false;
+	failed = false;
+
+	while ((rc = tds_process_tokens(tds, &resulttype, &done_flags, TDS_TOKEN_RESULTS)) == TDS_SUCCESS) {
+		const unsigned int stop_mask = TDS_RETURN_DONE | TDS_RETURN_ROW;
+
+		if (resulttype == TDS_DONE_RESULT && (done_flags & TDS_DONE_ERROR))
+			failed = true;
+		if (resulttype != TDS_ROW_RESULT)
+			continue;
+
+		/* We must keep processing result tokens (even if we've found what we're looking for) so that the
+		 * stream is ready for subsequent queries. */
+		while ((rc = tds_process_tokens(tds, &resulttype, &done_flags, stop_mask)) == TDS_SUCCESS) {
+			TDSCOLUMN *col;
+			TDS_SERVER_TYPE ctype;
+			CONV_RESULT dres;
+			TDS_INT res;
+
+			if (resulttype != TDS_ROW_RESULT) {
+				if (resulttype == TDS_DONE_RESULT && (done_flags & TDS_DONE_ERROR))
+					failed = true;
+				break;
+			}
+
+			/* Get INT4 from column 0 */
+			if (!tds->current_results || tds->current_results->num_cols < 1)
+				continue;
+
+			col = tds->current_results->columns[0];
+			if (col->column_cur_size < 0)
+				continue;
+
+			ctype = tds_get_conversion_type(col->column_type, col->column_size);
+			res = tds_convert(tds_get_ctx(tds), ctype, col->column_data, col->column_cur_size, SYBINT4, &dres);
+			if (res < 0)
+				continue;
+
+			value = dres.i;
+			value_found = true;
+		}
+	}
+	if (TDS_FAILED(rc))
+		return rc;
+
+	/* The row format depends on the answer: without a definite one (the probe
+	 * failed, or the table's lock scheme is unknown), nothing is sent. Servers
+	 * without data-only locking were left out above, by their capabilities. */
+	if (failed || !value_found || (value != 1 && value != 2)) {
+		tdsdump_log(TDS_DBG_ERROR, "[DOL BULK] No lock scheme found for '%s'.\n", full_tablename);
+		return TDS_FAIL;
+	}
+
+	tdsdump_log(TDS_DBG_INFO1, "lock scheme %u for '%s'\n", value, full_tablename);
+	if (value == 2) {
+		bcpinfo->datarows_locking = true;
+		tdsdump_log(TDS_DBG_INFO1, "Table has data-only locking; enabling DOL BULK format.\n");
+	}
+	return TDS_SUCCESS;
+}
