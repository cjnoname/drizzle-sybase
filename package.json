{
  "name": "drizzle-sybase",
  "version": "0.2.0",
  "description": "Drizzle ORM driver for Sybase ASE with built-in FreeTDS native bindings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/native/binding.c",
    "binding.gyp",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "build:native": "node-gyp rebuild",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check": "npm run lint && tsc --noEmit",
    "clean": "rm -rf dist build"
  },
  "keywords": [
    "drizzle",
    "sybase",
    "ase",
    "orm",
    "freetds",
    "tds",
    "database",
    "native",
    "napi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjnoname/drizzle-sybase.git"
  },
  "homepage": "https://github.com/cjnoname/drizzle-sybase#readme",
  "bugs": {
    "url": "https://github.com/cjnoname/drizzle-sybase/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "drizzle-orm": "^1.0.0-rc.2",
    "node-gyp": "^12.3.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "latest",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.2",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
