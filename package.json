{
  "name": "drizzle-sybase",
  "version": "2.0.0",
  "description": "Drizzle ORM driver for Sybase ASE with built-in FreeTDS native bindings",
  "keywords": [
    "ase",
    "database",
    "drizzle",
    "freetds",
    "napi",
    "native",
    "orm",
    "sybase",
    "tds"
  ],
  "homepage": "https://github.com/cjnoname/drizzle-sybase#readme",
  "bugs": {
    "url": "https://github.com/cjnoname/drizzle-sybase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjnoname/drizzle-sybase.git"
  },
  "bin": {
    "drizzle-sybase-introspect": "./dist/introspect/cli.js"
  },
  "files": [
    "dist",
    "src/native/binding.c",
    "binding.gyp",
    "scripts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./introspect": {
      "types": "./dist/introspect/index.d.ts",
      "import": "./dist/introspect/index.js"
    }
  },
  "scripts": {
    "install": "echo 'native addon is prebuilt — skip node-gyp'",
    "build": "tsc -p tsconfig.build.json",
    "build:native": "node-gyp rebuild",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "type": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check": "npm run lint && npm run type",
    "clean": "pnpm dlx --reporter=silent rimraf \"**/node_modules\" pnpm-lock.yaml \"**/dist\" -g && pnpm i"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "node-gyp": "^13.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "latest",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
