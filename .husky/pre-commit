#!/usr/bin/env sh
# Pre-commit hook: format, lint, and type-check the whole project.
#
# 1. Run `pnpm format` to auto-fix formatting across the project.
# 2. Re-stage any originally-staged file that oxfmt modified, so the
#    formatted content is included in the current commit. Files that were
#    not part of this commit are intentionally NOT re-added, to keep the
#    commit scope unchanged. A file only partly staged has its staged part
#    formatted in the index; its unstaged changes stay out of the commit.
# 3. Run `pnpm lint` and `pnpm type` in parallel. If either fails, abort
#    the commit so broken code never lands on a branch.

set -e

# Collect the list of files that were staged when the commit started, and
# those of them that also have unstaged changes — before formatting, which
# rewrites the working tree.
# `--cached --name-only --diff-filter=ACMR` = Added / Copied / Modified /
# Renamed files that are currently in the index. Deleted files are skipped
# (nothing to re-add). Binary/non-text files are safe — oxfmt ignores them.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
PARTIAL_FILES=""
if [ -n "$STAGED_FILES" ]; then
  # shellcheck disable=SC2086  # intentional word-splitting on newlines
  PARTIAL_FILES=$(git diff --name-only -- $STAGED_FILES)
fi

echo "[pre-commit] 1/3 formatting project (pnpm format)…"
pnpm --silent format

if [ -n "$STAGED_FILES" ]; then
  FORMATTED=$(mktemp)
  trap 'rm -f "$FORMATTED"' EXIT
  printf '%s\n' "$STAGED_FILES" | while IFS= read -r file; do
    if printf '%s\n' "$PARTIAL_FILES" | grep -Fqx -- "$file"; then
      # `git add` would take the unstaged changes too: format the staged
      # content itself and put it back in the index. oxfmt fails for a file
      # type it does not format (and for one it cannot parse, which lint and
      # type then report): the index is left as it is.
      if git show ":$file" | pnpm --silent exec oxfmt --stdin-filepath "$file" >"$FORMATTED" 2>/dev/null; then
        blob=$(git hash-object -w --path="$file" "$FORMATTED")
        if [ "$blob" != "$(git rev-parse ":$file")" ]; then
          mode=$(git ls-files --stage -- "$file" | cut -d' ' -f1)
          git update-index --cacheinfo "$mode,$blob,$file"
          echo "[pre-commit]   re-staged formatted (staged part only): $file"
        fi
      fi
    elif ! git diff --quiet -- "$file"; then
      # oxfmt changed it: the formatted content goes into this commit.
      git add -- "$file"
      echo "[pre-commit]   re-staged formatted: $file"
    fi
  done
fi

echo "[pre-commit] 2/3 running lint + type in parallel…"
# Reuse the concurrently binary (already a devDependency). Using
# `pnpm exec` avoids hard-coding the path; both commands run in parallel
# and the first failure fails the whole step.
# `pnpm type` (tsc --noEmit) rather than `pnpm build`: the build config excludes
# src/**/__tests__ so they stay out of the published dist, but they still have to
# be type-checked before a commit lands.
pnpm exec concurrently --raw --kill-others-on-fail \
  "pnpm --silent lint" \
  "pnpm --silent type"

echo "[pre-commit] 3/3 done — proceeding with commit."
